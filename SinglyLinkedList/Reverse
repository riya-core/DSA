#include <iostream>
using namespace std;
class Node {
public:
	int val;
	Node* next;
	Node(int v): val(v), next(NULL) {}
};
class single {
	Node *head;
public:
	single(): head(NULL) {}

	void i_at_end(int v) {
		Node * ptr= head, *nn= new Node(v);
		if(head==NULL) {
			head= nn;
			return ;
		}
		while( ptr->next!= NULL) {
			ptr=ptr->next;
		}
		ptr->next=nn;
	}
	void i_at_s(int v) {
		Node *nn= new Node (v);
		nn->next= head;
		head=nn;
	}
	void i_after(int v,int after) {
		if(head==NULL) {
			cout<<"\nList is empty...\n";
			return;
		}
		Node *ptr=head, *nn=new Node (v);
		
		while(ptr!= NULL &&ptr->val!=after) {
			ptr= ptr->next;
		}
		if(ptr== NULL) {
			cout<<"\nNo such element exist in the list\n";
			return;
		}
		nn->next= ptr->next;
		ptr->next= nn;
		return;
	}
	void i_before(int v, int before) {
		Node *ptr=head,*nn= new Node(v);
		if(ptr==NULL) {
			cout<<"\nList is empty...\n";
			return;
		}
		Node *cur=NULL;
		while(ptr!=NULL && ptr->val!=before) {
			cur=ptr;
			ptr=ptr->next;
		}
		if(ptr==NULL) {
			cout<<"\nNo such element exist in the list\n";
			return;
		}
		if(cur) {
			nn->next=ptr;
			cur->next=nn;
			return;
		}
		else {
			nn->next=head;
			head=nn;
		}
		return;
	}
	void del_beg() {
		if(!head) {
			cout<<"\nAlready empty..\n";
			return;
		}
		Node *temp=head;
		head=head->next;
		delete temp;
	}
	void del_end() {
		if(head==NULL) {
			cout<<"\nAlready empty..\n";
			return;
		}
		if(head->next==NULL) {
		    delete head;
		    head=NULL;
			return;
		}
		Node *ptr=head, *cur=NULL;

		while(ptr!=NULL && ptr->next!=NULL) {
			cur= ptr;
			ptr=ptr->next;
		}
		cur->next=NULL;
		delete ptr;
	}
	void del_sp(int v) {
		if(head==NULL) {
			cout<<"\nAlready empty..\n";
			return;
		}
		Node *cur=NULL,*ptr=head;
		
		while(ptr!= NULL && ptr->val!= v) {
			cur=ptr;
			ptr=ptr->next;
		}
		if(!ptr){
		    cout<<"\nno such element exists\n";
		    return;
		}
		if(cur) {
			cur->next=ptr->next;
			delete ptr;
			return;
		}
		head=ptr->next;
		delete ptr;
	}
	int search(int v) {
		if(head==NULL){
			cout<<"\nAlready empty..\n";
			return 0;
		}
		int count=1;
		Node *ptr= head;
		while(ptr!=NULL &&ptr->val!= v) {
			ptr=ptr->next;
			count++;
		}
		if(ptr)
		return count;
		else return 0;
	}
	void display() {
		if(!head) {
			cout<<"\nAlready empty..\n";
			return;
		}
		Node *ptr=head;
		while(ptr) {
			cout<<ptr->val<<"  ";
			ptr=ptr->next;
		}
		cout<<endl;
	}
	void reverse() {
        Node* prev = NULL;
        Node* curr = head;
        Node* next = NULL;

        while (curr != NULL) {
            next = curr->next;  
            curr->next = prev;   
            prev = curr;       
            curr = next;        
        }

        head = prev; 
    }

};
int main()
{
	int choice;
	single Q;
	int num, var,ans;
	while(1) {
		cout<<"choose from this menu to implement the operation u wanna on this linkedList\n1.insert at beginning\n2.Insertion at the end.\n 3.Insertion before\n 4. Insertion after\n5. Deletion from the beginning. \n 6.Deletion from the end.\n 7.Deletion of a specific\n8.Search for a node\n 9.Display\n10.Exit\n";
		    cin>>choice;
		switch(choice) {
		case 1:
		    cout<<"\nEnter the value to be inseted at start:\n";
		    cin>>num;
			Q.i_at_s(num);
			break;
		case 2:
		    cout<<"\nEnter the value to be inseted at end:\n";
		    cin>>num;
			Q.i_at_end(num);
			break;
		case 3:
		    cout<<"\nEnter the value to be inserted and also before what:\n";
		    cin>>num>>var;
		    Q.i_before(num, var);
			break;
		case 4:
		    cout<<"\nEnter the value to be inserted and also after what:\n";
		    cin>>num>>var;
		    Q.i_after(num, var);
			break;
		case 5:
			Q.del_beg();
			break;
		case 6:
			Q.del_end();
			break;
			case 7:
			cout<<"\nWhich element to be deleted\n";
			cin>>num;
			Q.del_sp(num);
			break;
		case 8:
		    cout<<"\nEnter the value to be searched:\n";
		    cin>>num;
			ans=Q.search(num);
			if(ans){
			    cout<<"\nFound the element at "<<ans<<"ahead from head\n";
			}
			else cout<<"\nNo such element found\n";
			break;
		case 9:
			Q.display();
			break;
		case 10:
		    Q.reverse();
		}
	}
}
